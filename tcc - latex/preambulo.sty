% Configurações de legenda
\usepackage{caption}
\captionsetup{
    format=plain,            % parágrafo normal
    labelformat=simple,      % legenda será nome e número
    labelsep=endash,         % separador do título e descrição da legenda
    textformat=period,       % termina a legenda com um ponto final
    justification=centering, % legenda centralizada
    font=small,              % fonte menor que a normal do texto
    within=none,             % omite o número do capítulo da legenda
                             % comentar a linha para incluir o número do cap.
}
% Cria um comando para inserir a fonte das figuras e tabelas.
\newcommand{\source}[1]{\caption*{Fonte: {#1}}}

% Habilita hyperlinks no sumário (tanto no título quanto no número da página), mas os deixa na própria cor do texto (senão, ficariam em azul)
\usepackage[linktoc=all, hidelinks]{hyperref}

% Configurações do sumário
\usepackage{titletoc}
% Os comandos titlecontents servem para formatar as entradas do sumário de forma que os números de seções fiquem alinhados à margem esquerda e os nomes das seções fiquem alinhados entre si, usando como referência o título cuja numeração é mais longa (subsubsection). Por tentativa e erro, essa medida foi determinada como 4pc.
% Sobre a formatação do sumário: para que os capítulos e seções ficassem em maiúsculo, foi necessário usar o comando \uppercase
%   ao invés do comando \MakeUppercase. Usando o \MakeUppercase dá conflito com o pacote hyperref.
%   fonte: https://groups.google.com/g/comp.text.tex/c/rXbFGDych8o
\titlecontents{chapter}
    [3.5pc] % Margem esquerda medida a partir da margem esquerda da página
    {\bfseries} % Formatação global da entrada do sumário
    {\contentslabel{3.5pc}\uppercase} % Formatação para a entrada com número
    {\uppercase} % Formatação para a entrada sem número
    {\titlerule*[0.3pc]{.}\contentspage} % Preenchimento entre o título da entrada e o número da página
\titlecontents{section}
    [3.5pc]
    {}
    {\contentslabel{3.5pc}\uppercase}
    {}
    {\titlerule*[0.3pc]{.}\contentspage}
\titlecontents{subsection}
    [3.5pc]
    {\bfseries}
    {\contentslabel{3.5pc}}
    {}
    {\titlerule*[0.3pc]{.}\contentspage}
\titlecontents{subsubsection}
    [3.5pc]
    {\itshape}
    {\contentslabel{3.5pc}}
    {}
    {\titlerule*[0.3pc]{.}\contentspage}
% Comentado pois não sei se serve pra alguma coisa
%\titlecontents{numberless-entry-format}[3.5pc]{}         {\contentslabel{3.5pc}}{}{\titlerule*[0.3pc]{.}\contentspage}

% Configurações para lista de figuras e tabelas
% Fonte: https://tex.stackexchange.com/a/525781/186109
% Foi usando -- pois é o equivalente ao endash do pacote caption usado para as legendas.
% Fonte: https://tex.stackexchange.com/a/53637/186109

\titlecontents{figure}[0mm]%
    {\makebox{\figurename~}}%
    {\makebox{\thecontentslabel~--~}}%
    {}%
    {~\dotfill~\thecontentspage}
    % {\enspace\dotfill\enspace\thecontentspage}

\titlecontents{table}[0mm]%
    {\makebox{\tablename~}}%
    {\makebox{\thecontentslabel~--~}}%
    {}%
    {~\dotfill~\thecontentspage}
    % {\enspace\dotfill\enspace\thecontentspage}

% Faz com que o sumário mostre até 3 níveis de seção (4 números)
\setcounter{tocdepth}{3}

% Faz com que sejam seções de até 3 níveis sejam numeradas (4 números)
\setcounter{secnumdepth}{3}

% Elimina a página vazia depois do sumário
\let\cleardoublepage=\clearpage

% Centraliza o título do sumário
\addto\captionsportuguese{\renewcommand\contentsname{\hfill\bfseries\MakeUppercase Sumário \hfill}}
% Centraliza o título da lista de figuras
\addto\captionsportuguese{\renewcommand\listfigurename{\hfill\bfseries\MakeUppercase Lista de Figuras \hfill}}
% Centraliza o título da lista de tabelas
\addto\captionsportuguese{\renewcommand\listtablename{\hfill\bfseries\MakeUppercase Lista de Tabelas \hfill}}

% Configura posicionamento dos títulos de capítulos e seções nas páginas e em referência aos parágrafos.
% Os capítulos sem numeração (referências bibliográficas e \chapter*{}) devem ser centralizados.
\usepackage{titlesec}
\titleformat{\chapter}
    [hang]
    {\bfseries\MakeUppercase}
    {\thechapter}
    {10pt}
    {\bfseries}
\titleformat{name=\chapter,numberless}
    [hang]
    {\centering\bfseries\MakeUppercase}
    {} % Deixar vazio para remover a numeração nos capítulos sem número
    {10pt}
    {\bfseries}
\titleformat{\section}
    [hang]
    {\MakeUppercase}
    {\thesection}
    {10pt}
    {}
\titleformat{\subsection}
    [hang]
    {\bfseries}
    {\thesubsection}
    {10pt}
    {\bfseries}
\titleformat{\subsubsection}
    [hang]
    {\itshape}
    {\thesubsubsection}
    {10pt}
    {\itshape}

% Ajustes de espaçamento antes/depois de nome de capítulo, seção, etc, para que fiquem dentro da página
% Os limites da página podem ser visualizados com o pacote showframe
\titlespacing{\chapter}{0pt}{-20pt}{5pt}      % Ajusta o espaçamento antes do capítulo
\titlespacing{\section}{0pt}{5pt}{5pt}      % Ajusta o espaçamento depois da seção
\titlespacing{\subsection}{0pt}{5pt}{5pt}      % Ajusta o espaçamento antes e depois da subseção
\titlespacing{\subsubsection}{0pt}{5pt}{5pt}      % Ajusta o espaçamento antes e depois da subseção

% Configurações de cabeçalho/rodapé para os números de página
\usepackage{fancyhdr}

\fancypagestyle{plain}{
    \fancyhf{}
    \fancyhead[R]{\thepage}
    \fancyfoot{}
    \renewcommand{\headrulewidth}{0pt} % Elimina a linha horizontal no cabeçalho
    \renewcommand{\footrulewidth}{0pt} % Elimina a linha horizontal no rodapé
}

\fancypagestyle{capitulos}{
    \fancyhf{}
    \fancyhead[R]{\thepage} % Coloca o número da página no canto superior direito de todas as páginas
    \fancyfoot{}
    \renewcommand{\headrulewidth}{0pt} % Elimina a linha horizontal no cabeçalho
    \renewcommand{\footrulewidth}{0pt} % Elimina a linha horizontal no rodapé
}

